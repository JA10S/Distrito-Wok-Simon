rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /arroces/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /corrientes/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /porciones/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bebidas/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /roles/{roleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /orders/{orderId} {
      // Seguimiento público por ID (pedido para llevar del cliente)
      allow get: if true;
      // Listado de pedidos: solo personal autenticado
      allow list: if request.auth != null;
      // Crear: autenticados (mesa) o invitados con pedido para llevar validado
      allow create: if request.auth != null
        || (request.resource.data.type in ['delivery', 'pickup']
            && request.resource.data.source == 'client'
            && request.resource.data.status == 'pending'
            && request.resource.data.paymentStatus == 'pending'
            && request.resource.data.items is list
            && request.resource.data.items.size() > 0
            && request.resource.data.items.size() <= 50
            && request.resource.data.total is number
            && request.resource.data.customer is map
            && request.resource.data.customer.name is string
            && request.resource.data.customer.name.size() > 0
            && request.resource.data.customer.phone is string
            && request.resource.data.customer.phone.size() >= 7
            && (request.resource.data.type == 'pickup'
                || (request.resource.data.customer.address is string
                    && request.resource.data.customer.address.size() > 0)));
      allow update, delete: if request.auth != null;
    }
    match /deliveries/{deliveryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /tables/{tableId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
