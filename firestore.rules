rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /arroces/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /corrientes/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /porciones/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bebidas/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /roles/{roleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    match /tables/{tableId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
